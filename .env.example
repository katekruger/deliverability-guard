# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Instantly v2 API key. Needs scopes: accounts:update, accounts:all
# (or all:update / all:all). See https://developer.instantly.ai
INSTANTLY_API_KEY=

# Smartlead API key. See https://helpcenter.smartlead.ai/en/articles/125-full-api-documentation
# Only needed if config/thresholds.yml sets `provider: smartlead`.
SMARTLEAD_API_KEY=

# The Smartlead campaign to read stats from. Smartlead's statistics endpoint
# is per-campaign, not global per-mailbox (unlike Instantly's) — see
# providers/smartlead.py's module docstring. Only needed with `provider:
# smartlead`.
SMARTLEAD_CAMPAIGN_ID=

# lemlist API key. See https://lemlist.com/api
# Only needed if config/thresholds.yml sets `provider: lemlist`.
LEMLIST_API_KEY=

# The lemlist campaign to read stats from — lemlist's activities export is
# per-campaign, not global. Only needed with `provider: lemlist`.
LEMLIST_CAMPAIGN_ID=

# Apollo.io API key. See https://apolloio.github.io/apollo-api-docs/
# Only needed if config/thresholds.yml sets `provider: apollo`.
APOLLO_API_KEY=

# The Apollo campaign (sequence) to read stats from — Apollo's daily_stats
# endpoint is per-campaign, not global. Only needed with `provider: apollo`.
APOLLO_CAMPAIGN_ID=

# The SES configuration set to read CloudWatch Send/Bounce metrics for and
# pause. Only needed if config/thresholds.yml sets `provider: ses`.
SES_CONFIGURATION_SET_NAME=

# SES authenticates via boto3's normal AWS credential chain (this project
# never reads an SES-specific API key) — but the region is read explicitly
# from here rather than relying on this machine's ambient AWS config, so
# `deliverability-guard` constructs deterministically. Only needed with
# `provider: ses`.
AWS_REGION=

# No credentials are needed for `provider: noop` — it reports a small
# synthetic fixture and exists purely to exercise the CLI end to end
# without a live account.
