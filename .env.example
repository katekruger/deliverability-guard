# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Instantly v2 API key. Needs scopes: accounts:update, accounts:all
# (or all:update / all:all). See https://developer.instantly.ai
INSTANTLY_API_KEY=

# Smartlead API key. See https://helpcenter.smartlead.ai/en/articles/125-full-api-documentation
# Only needed if config/thresholds.yml sets `provider: smartlead`.
SMARTLEAD_API_KEY=

# The Smartlead campaign to read stats from. Smartlead's statistics endpoint
# is per-campaign, not global per-mailbox (unlike Instantly's) — see
# providers/smartlead.py's module docstring. Only needed with `provider:
# smartlead`.
SMARTLEAD_CAMPAIGN_ID=

# No credentials are needed for `provider: noop` — it reports no mailboxes
# and exists purely to exercise the CLI end to end without a live account.
